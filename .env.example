# Stake credentials
# Preferred: set STAKE_SESSION_TOKEN (copy from browser cookies after logging in to hellostake.com/au).
# The token is persisted to the database on first use, so subsequent restarts work even if this is blank.
STAKE_SESSION_TOKEN=

# Bootstrap only: set username/password on first run if you have no session token.
# On startup the app authenticates, saves the token to the database, and logs it so you can
# copy it to STAKE_SESSION_TOKEN above. Clear these fields once you have the token.
# STAKE_USERNAME=
# STAKE_PASSWORD=

# Financial Modeling Prep
FMP_API_KEY=

# Infrastructure
DATABASE_URL=postgresql+asyncpg://stake:stake@db:5432/stake_dashboard
REDIS_URL=redis://redis:6379/0

# Frontend (set at build time)
VITE_API_URL=http://localhost:8000
