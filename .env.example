# Stake credentials (OPTIONAL — only for auto-sync; manual tracking works without these).
# Preferred: use the dashboard "Connect Stake" login flow. Or set a fallback token here:
# the Stake-Session-Token is a REQUEST HEADER (not a cookie) on calls to
# api2.prd.hellostake.com — find it in DevTools > Network after logging in to
# trading.hellostake.com. The database token takes priority after one is saved.
STAKE_SESSION_TOKEN=

# Bootstrap only (advanced): exchange username/password for a token on first run.
# STAKE_OTP is your current 2FA code if your account has 2FA (it is short-lived).
# The token is saved to the database; clear these fields afterwards.
# STAKE_USERNAME=
# STAKE_PASSWORD=
# STAKE_OTP=

# Financial Modeling Prep
FMP_API_KEY=

# Infrastructure
DATABASE_URL=postgresql+asyncpg://stake:stake@db:5432/stake_dashboard
REDIS_URL=redis://redis:6379/0

# Frontend (set at build time)
VITE_API_URL=http://localhost:8000
